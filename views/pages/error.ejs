<%- include('../partials/header') %>

<div class="container" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 50px 20px;">
  <div class="card" style="max-width: 500px; width: 100%; text-align: center; padding: 40px 30px;">
    <div style="font-size: 60px; color: #ef4444; margin-bottom: 15px;">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>

    <h1 style="font-size: 32px; margin-bottom: 12px; color: var(--text-main);">
      <%= typeof errorCode !== 'undefined' ? errorCode : 500 %>
    </h1>

    <h2 style="font-size: 20px; margin-bottom: 14px; color: var(--text-main);">
      <%= typeof title !== 'undefined' ? title : t('حدث خطأ', 'An error occurred') %>
    </h2>

    <p style="color: var(--text-muted); margin-bottom: 25px; line-height: 1.7;">
      <%= typeof errorMessage !== 'undefined' ? errorMessage : t('نعتذر عن هذا الخطأ، يمكنك العودة للصفحة الرئيسية.', 'Sorry for the error, you can return to home.') %>
    </p>

    <a href="/" class="btn btn-primary">
      <i class="fa-solid fa-house"></i> <%= t('العودة للرئيسية', 'Return to Home') %>
    </a>
  </div>
</div>

<%- include('../partials/footer') %>
