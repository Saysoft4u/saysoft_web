<%- include('../partials/header') %>

<div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 50px 20px;">
  <div class="card" style="max-width: 680px; width: 100%; text-align: center; padding: 45px 35px; border-radius: 16px; border: 1px solid var(--border-color); box-shadow: 0 10px 30px rgba(0,0,0,0.08); background: var(--card-bg, #ffffff);">
    
    <!-- الشعار: شعار المنظومة المحددة أو شعار الموقع -->
    <% if (typeof targetSystem !== 'undefined' && targetSystem) { %>
      <div style="display: flex; justify-content: center; margin-bottom: 22px;">
        <img src="<%= targetSystem.AppLogo || targetSystem.Logo %>" alt="<%= targetSystem.BrandNameAr || targetSystem.NameAr %>" 
             style="width: 85px; height: 85px; border-radius: 18px; object-fit: cover; border: 2px solid var(--border-color); box-shadow: 0 6px 16px rgba(0,0,0,0.08); padding: 3px; background: #ffffff;">
      </div>

      <div style="display: inline-flex; align-items: center; gap: 8px; padding: 5px 16px; background: #fef3c7; color: #b45309; border-radius: 30px; font-weight: 700; font-size: 13px; margin-bottom: 14px; border: 1px solid #fde68a;">
        <i class="fa-solid fa-compass-drafting"></i> <%= t('قريباً أو قيد التصميم والتجهيز', 'Coming Soon & Under Design') %>
      </div>

      <!-- اسم المنظومة التجاري والعنوان -->
      <h1 style="font-size: 24px; font-weight: 800; margin-bottom: 6px; color: var(--text-main); line-height: 1.35;">
        <%= lang === 'en' ? targetSystem.NameEn : targetSystem.NameAr %>
      </h1>
      
      <% if (targetSystem.BrandNameAr || targetSystem.BrandNameEn) { %>
        <div style="font-size: 15px; font-weight: 800; color: var(--primary-color); margin-bottom: 14px;">
          <%= lang === 'en' ? (targetSystem.BrandNameEn || targetSystem.BrandNameAr) : (targetSystem.BrandNameAr || targetSystem.BrandNameEn) %>
          <% if (targetSystem.AppCode) { %>
            <span style="font-size: 12px; color: var(--text-muted); font-weight: 600;">(Port: <%= targetSystem.AppCode %>)</span>
          <% } %>
        </div>
      <% } %>

      <p style="color: var(--text-muted); font-size: 15px; line-height: 1.75; margin-bottom: 28px; max-width: 580px; margin-inline: auto;">
        <%= t(
          'النسخة التجريبية الحية (Live Demo) الخاصة بهذه المنظومة قيد التصميم والتجهيز البرمجي حالياً، وسيتم نشرها قريباً جداً. سجّل بياناتك لتكون أول من يستلم رابط وبيانات الدخول فور إتاحتها.',
          'The live interactive demo for this system is currently under active design and technical staging, and will be launched soon. Subscribe now to receive priority early access credentials upon release.'
        ) %>
      </p>

    <% } else { %>
      <!-- الشعار العام للموقع -->
      <% if (settings.SiteLogo) { %>
        <img src="<%= settings.SiteLogo %>" alt="Saysoft Logo" style="height: 65px; margin-bottom: 20px; object-fit: contain;">
      <% } %>

      <div style="display: inline-flex; align-items: center; gap: 8px; padding: 5px 16px; background: var(--primary-light); color: var(--primary-color); border-radius: 30px; font-weight: 700; font-size: 13px; margin-bottom: 14px;">
        🚀 <%= t('نستعد للإطلاق قريباً | قيد التصميم والإنتاج', 'Launching Soon | Under Construction') %>
      </div>

      <h1 style="font-size: 26px; font-weight: 800; margin-bottom: 14px; color: var(--text-main);">
        <%= lang === 'en' ? settings.SiteNameEn : settings.SiteNameAr %>
      </h1>

      <p style="color: var(--text-muted); font-size: 15px; line-height: 1.8; margin-bottom: 28px;">
        <%= lang === 'en' ? (settings.ComingSoonMessageEn || 'We are preparing to launch the new Saysoft platform with advanced SaaS enterprise systems.') : (settings.ComingSoonMessageAr || 'نستعد لإطلاق منصة سايسوفت الجديدة بأحدث منظومات وحلول إدارة الأعمال السحابية.') %>
      </p>
    <% } %>

    <!-- رسائل التنبيه -->
    <% if (typeof status !== 'undefined' && status === 'success') { %>
      <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 14px 16px; border-radius: 10px; margin-bottom: 24px; font-size: 13.5px; font-weight: 600; text-align: center;">
        <i class="fa-solid fa-circle-check"></i> <%= t('شكراً لك! تم تسجيل بياناتك بنجاح، وسنرسل لك إشعاراً ورابط الدخول فور الإطلاق!', 'Thank you! You are subscribed and will be notified upon release.') %>
      </div>
    <% } else if (typeof status !== 'undefined' && status === 'missing') { %>
      <div style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 14px 16px; border-radius: 10px; margin-bottom: 24px; font-size: 13.5px; font-weight: 600; text-align: center;">
        <i class="fa-solid fa-circle-exclamation"></i> <%= t('يرجى إدخال الاسم الكريم ورقم الواتساب لاستكمال التسجيل.', 'Please enter your name and WhatsApp number.') %>
      </div>
    <% } %>

    <!-- نموذج الاشتراك في قائمة الوصول المبكر -->
    <form action="/api/subscribe-coming-soon" method="POST" style="text-align: right; margin-bottom: 28px;">
      <% if (typeof targetSystem !== 'undefined' && targetSystem) { %>
        <input type="hidden" name="systemSlug" value="<%= targetSystem.Slug %>">
        <input type="hidden" name="systemName" value="<%= targetSystem.BrandNameAr || targetSystem.NameAr %>">
      <% } %>

      <div style="margin-bottom: 14px;">
        <label style="display: block; font-weight: 700; margin-bottom: 6px; font-size: 13.5px; color: var(--text-main);">
          <%= t('الاسم الكريم / المؤسسة', 'Full Name / Organization') %> <span style="color: #ef4444;">*</span>
        </label>
        <input type="text" name="fullName" required placeholder="<%= t('أدخل اسمك الكريم أو اسم شركتك', 'Enter your name or company') %>" 
               class="form-control" style="height: 42px; font-size: 13.5px;">
      </div>

      <div style="margin-bottom: 18px;">
        <label style="display: block; font-weight: 700; margin-bottom: 6px; font-size: 13.5px; color: var(--text-main);">
          <%= t('رقم الواتساب لاستلام رابط التجربة', 'WhatsApp Number for Demo Access') %> <span style="color: #ef4444;">*</span>
        </label>
        <input type="text" name="whatsappNumber" required placeholder="01000000000 / +966..." 
               class="form-control" style="direction: ltr; text-align: right; height: 42px; font-size: 13.5px;">
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; padding: 13px; font-size: 15px; font-weight: 700; justify-content: center; box-shadow: 0 4px 14px rgba(2, 132, 199, 0.25);">
        <i class="fa-solid fa-bell"></i> <%= t('أبلغني وامنحني صلاحية الدخول فور الإطلاق', 'Notify Me & Grant Early Access On Launch') %>
      </button>
    </form>

    <!-- أزرار الإجراءات السريعة البديلة لمنع أي رابط مكسور -->
    <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 24px;">
      <% if (typeof targetSystem !== 'undefined' && targetSystem) { %>
        <a href="/system/<%= targetSystem.Slug %>" class="btn btn-outline btn-sm" style="padding: 9px 16px; font-weight: 700;">
          <i class="fa-solid fa-file-lines"></i> <%= t('استعراض تفاصيل ومميزات المنظومة', 'View System Details') %>
        </a>
      <% } %>
      <a href="/systems" class="btn btn-outline btn-sm" style="padding: 9px 16px; font-weight: 700;">
        <i class="fa-solid fa-shapes"></i> <%= t('كتالوج المنظومات', 'Systems Catalog') %>
      </a>
      <% if (settings.WhatsappNumber) { %>
        <a href="https://wa.me/<%= settings.WhatsappNumber.replace(/\+/g, '') %>?text=<%= encodeURIComponent(t('مرحباً سايسوفت، أود الاستفسار عن موعد إطلاق النسخة التجريبية لمنظومة: ' + (typeof targetSystem !== 'undefined' && targetSystem ? (targetSystem.BrandNameAr || targetSystem.NameAr) : 'سايسوفت'), 'Hello Saysoft, I want to inquire about the live demo release.')) %>" 
           target="_blank" class="btn btn-outline btn-sm" style="color: #16a34a; border-color: #86efac; font-weight: 700; padding: 9px 16px;">
          <i class="fa-brands fa-whatsapp"></i> <%= t('محادثة مستشار الأنظمة', 'Chat with Consultant') %>
        </a>
      <% } %>
    </div>

    <!-- الشبكات الاجتماعية -->
    <div style="display: flex; justify-content: center; gap: 16px; font-size: 18px; color: var(--text-muted); border-top: 1px solid var(--border-color); padding-top: 18px;">
      <% if (settings.SocialFacebook) { %><a href="<%= settings.SocialFacebook %>" target="_blank" style="color: inherit;"><i class="fa-brands fa-facebook"></i></a><% } %>
      <% if (settings.SocialTwitter) { %><a href="<%= settings.SocialTwitter %>" target="_blank" style="color: inherit;"><i class="fa-brands fa-x-twitter"></i></a><% } %>
      <% if (settings.SocialLinkedin) { %><a href="<%= settings.SocialLinkedin %>" target="_blank" style="color: inherit;"><i class="fa-brands fa-linkedin"></i></a><% } %>
      <% if (settings.SocialYoutube) { %><a href="<%= settings.SocialYoutube %>" target="_blank" style="color: inherit;"><i class="fa-brands fa-youtube"></i></a><% } %>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
