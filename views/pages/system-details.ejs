        <% } else { %>
          <p style="color: var(--text-muted); font-size: 14px;"><%= t('تواصل معنا للاستفسار عن الباقات المخصصة.', 'Contact us for custom enterprise pricing.') %></p>
        <% } %>
      </div>

      <!-- نموذج الاستفسار السريع أسفل الصفحة -->
      <div id="inquiryForm" class="card" style="padding: 26px;">
        <h3 style="font-size: 17px; font-weight: 800; color: var(--text-main); margin-bottom: 6px;">
          <i class="fa-solid fa-headset" style="color: var(--primary-color);"></i> <%= t('استفسار مباشر عن المنظومة', 'Inquire About This System') %>
        </h3>
        <p style="font-size: 13px; color: var(--text-muted); margin-bottom: 18px;">
          <%= t('اترك بياناتك وسيتواصل معك مستشار الحلول الرقمية فوراً', 'Leave your details and our team will get in touch') %>
        </p>

        <% if (inquiryStatus === 'success') { %>
          <div style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 12px; border-radius: 8px; margin-bottom: 16px; font-size: 13px;">
            <i class="fa-solid fa-circle-check"></i> <%= t('شكراً لك! تم استلام استفسارك وسنتواصل معك سريعاً.', 'Thank you! Your inquiry was received.') %>
          </div>
        <% } %>

        <form action="/system/<%= system.Slug %>/inquiry" method="POST">
          <input type="hidden" name="systemId" value="<%= system.IDSystem %>">
          <input type="hidden" name="systemName" value="<%= lang === 'en' ? system.NameEn : system.NameAr %>">

          <div style="margin-bottom: 12px;">
            <label style="display: block; font-size: 12px; font-weight: 700; margin-bottom: 4px;"><%= t('الاسم الكريم', 'Your Name') %> *</label>
            <input type="text" name="senderName" required class="form-control" placeholder="<%= t('أدخل اسمك', 'Full name') %>">
          </div>

          <div style="margin-bottom: 12px;">
            <label style="display: block; font-size: 12px; font-weight: 700; margin-bottom: 4px;"><%= t('رقم الواتساب', 'WhatsApp Number') %> *</label>
            <input type="text" name="whatsappNumber" required class="form-control" placeholder="01000000000" style="direction: ltr; text-align: right;">
          </div>

          <div style="margin-bottom: 12px;">
            <label style="display: block; font-size: 12px; font-weight: 700; margin-bottom: 4px;"><%= t('البريد الإلكتروني', 'Email') %></label>
            <input type="email" name="email" class="form-control" placeholder="user@company.com" style="direction: ltr; text-align: right;">
          </div>

          <div style="margin-bottom: 16px;">
            <label style="display: block; font-size: 12px; font-weight: 700; margin-bottom: 4px;"><%= t('نص الاستفسار', 'Message') %> *</label>
            <textarea name="message" required class="form-control" rows="3" placeholder="<%= t('أود الاستفسار عن إمكانية...', 'I would like to inquire about...') %>"></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%;">
            <i class="fa-solid fa-paper-plane"></i> <%= t('إرسال الاستفسار', 'Submit Inquiry') %>
          </button>
        </form>
      </div>

    </div>

  </div>
</div>

<!-- Schema.org JSON-LD Structured Data for SoftwareApplication -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "<%= (lang === 'en' ? system.NameEn : system.NameAr).replace(/"/g, '\\"') %>",
  "operatingSystem": "Web, Cloud, iOS, Android, Windows, macOS",
  "applicationCategory": "BusinessApplication",
  "description": "<%= (lang === 'en' ? system.SummaryEn : system.SummaryAr).replace(/"/g, '\\"') %>",
  "image": "<%= system.Logo %>",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "<%= Math.max(18, (system.ViewsCount % 60) + 12) %>"
  },
  <% if (system.Packages && system.Packages.length > 0) { %>
  "offers": {
    "@type": "AggregateOffer",
    "lowPrice": "<%= Math.min(...system.Packages.map(p => p.Price)) %>",
    "highPrice": "<%= Math.max(...system.Packages.map(p => p.Price)) %>",
    "priceCurrency": "<%= settings.PrimaryCurrency || 'USD' %>"
  }
  <% } else { %>
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "<%= settings.PrimaryCurrency || 'USD' %>"
  }
  <% } %>
}
</script>

<%- include('../partials/footer') %>
