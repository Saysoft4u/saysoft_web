                <!-- زر الإضافة للسلة -->
                <form action="/cart/add" method="POST">
                  <input type="hidden" name="packageId" value="<%= pkg.IDPackage %>">
                  <input type="hidden" name="systemSlug" value="<%= system.Slug %>">
                  <button type="submit" class="btn btn-primary btn-sm" style="width: 100%;">
                    <i class="fa-solid fa-cart-plus"></i> <%= t('أضف إلى السلة', 'Add to Cart') %>
                  </button>
