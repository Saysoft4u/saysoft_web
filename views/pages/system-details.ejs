      <script>
        // إعداد مشاهد الفيديو المستمدة من موارد المنظومة في الموقع المحلي
        const systemVideoScenes = [
          {
            title: "<%= lang === 'en' ? 'System Identity & Launch' : 'الهوية الرسمية لمنظومة ' + (system.BrandNameAr || system.NameAr) %>",
            caption: "<%= lang === 'en' ? (system.SummaryEn || system.NameEn) : (system.SummaryAr || system.NameAr) %>",
            image: "<%= system.CoverImage || system.Logo %>",
            duration: 7
          },
          <% (system.Images || []).forEach(function(img, i) { %>
          {
            title: "<%= lang === 'en' ? (img.CaptionEn || 'Core Feature ' + (i+1)) : (img.CaptionAr || 'الواجهة الرئيسية ' + (i+1)) %>",
            caption: "<%= lang === 'en' ? (img.CaptionEn || 'Live operating interface from ' + (system.BrandNameEn || system.NameEn)) : (img.CaptionAr || 'استعراض الواجهة الفعلية وأدوات التشغيل لمنظومة ' + (system.BrandNameAr || system.NameAr)) %>",
            image: "<%= img.ImagePath %>",
            duration: 7
          },
          <% }); %>
          {
            title: "<%= lang === 'en' ? 'Packages & Deployment' : 'باقات الاشتراك والتشغيل السحابي والمحلي' %>",
            caption: "<%= lang === 'en' ? 'Flexible subscription plans with continuous 24/7 technical support and secure encrypted storage.' : 'باقات ترخيص مرنة تناسب المحامي الفردي والمكاتب والشركات القانونية مع دعم فني مستمر 24/7 وأعلى معايير التشفير.' %>",
            image: "<%= system.CoverImage || system.Logo %>",
            duration: 7
          }
        ];

        let currentSceneIndex = 0;
        let isVideoPlaying = false;
        let videoPlaybackTimer = null;
        let elapsedSeconds = 0;
        const totalDuration = systemVideoScenes.reduce((sum, s) => sum + s.duration, 0);
        let isVoiceEnabled = true;

        function initVideoPlayer() {
          const scenesContainer = document.getElementById('controlScenesTabs');
          if (scenesContainer) {
            scenesContainer.innerHTML = '';
            systemVideoScenes.forEach((scene, idx) => {
              const btn = document.createElement('button');
              btn.type = 'button';
              btn.className = 'scene-pill-btn' + (idx === 0 ? ' active' : '');
              btn.textContent = '<%= lang %>' === 'en' ? ('Scene ' + (idx + 1)) : ('المشهد ' + (idx + 1));
              btn.onclick = () => jumpToScene(idx);
              scenesContainer.appendChild(btn);
            });
          }
          renderScene(0);
        }

        function renderScene(index) {
          if (index < 0 || index >= systemVideoScenes.length) return;
          currentSceneIndex = index;
          const scene = systemVideoScenes[index];

          const bgLayer = document.getElementById('videoBgLayer');
          if (bgLayer) {
            bgLayer.style.opacity = '0.3';
            setTimeout(() => {
              bgLayer.style.backgroundImage = 'url(' + scene.image + ')';
              bgLayer.style.opacity = '1';
            }, 200);
          }

          const titleEl = document.getElementById('videoSceneTitle');
          if (titleEl) titleEl.textContent = scene.title;

          const badgeEl = document.getElementById('videoSceneBadgeText');
          if (badgeEl) badgeEl.textContent = ('<%= lang %>' === 'en' ? 'Scene ' : 'المشهد ') + (index + 1) + ' / ' + systemVideoScenes.length;

          const stepEl = document.getElementById('ccStepIndicator');
          if (stepEl) stepEl.textContent = (index + 1) + ' / ' + systemVideoScenes.length;

          const ccEl = document.getElementById('videoCcBody');
          if (ccEl) ccEl.textContent = scene.caption;

          // تحديث شارات المشاهد النشطة
          const badges = document.querySelectorAll('.scene-pill-btn');
          badges.forEach((b, i) => {
            if (i === index) b.classList.add('active');
            else b.classList.remove('active');
          });

          // نطق صوتي عربي فصيح إذا كان مفعل والمشغل يعمل
          if (isVideoPlaying && isVoiceEnabled && 'speechSynthesis' in window) {
            try {
              window.speechSynthesis.cancel();
              const utterance = new SpeechSynthesisUtterance(scene.title + '. ' + scene.caption);
              utterance.lang = '<%= lang %>' === 'en' ? 'en-US' : 'ar-SA';
              utterance.rate = 0.95;
              window.speechSynthesis.speak(utterance);
            } catch (e) {}
          }
        }

        function togglePlayState() {
          if (isVideoPlaying) {
            pauseVideo();
          } else {
            playVideo();
          }
        }

        function playVideo() {
          isVideoPlaying = true;
          document.getElementById('videoCenterPlay').style.opacity = '0';
          document.getElementById('videoCenterPlay').style.pointerEvents = 'none';
          document.getElementById('ctlPlayIcon').className = 'fa-solid fa-pause';

          if (videoPlaybackTimer) clearInterval(videoPlaybackTimer);
          videoPlaybackTimer = setInterval(() => {
            elapsedSeconds += 0.5;
            if (elapsedSeconds >= totalDuration) {
              elapsedSeconds = totalDuration;
              updateTimelineUI();
              pauseVideo();
              return;
            }
            updateTimelineUI();

            // فحص الانتقال إلى المشهد المناسب
            let acc = 0;
            for (let i = 0; i < systemVideoScenes.length; i++) {
              acc += systemVideoScenes[i].duration;
              if (elapsedSeconds < acc) {
                if (currentSceneIndex !== i) {
                  renderScene(i);
                }
                break;
              }
            }
          }, 500);

          renderScene(currentSceneIndex);
        }

        function pauseVideo() {
          isVideoPlaying = false;
          if (videoPlaybackTimer) clearInterval(videoPlaybackTimer);
          document.getElementById('videoCenterPlay').style.opacity = '1';
          document.getElementById('videoCenterPlay').style.pointerEvents = 'auto';
          document.getElementById('ctlPlayIcon').className = 'fa-solid fa-play';
          if ('speechSynthesis' in window) {
            window.speechSynthesis.cancel();
          }
        }

        function restartShowcase() {
          elapsedSeconds = 0;
          jumpToScene(0);
          playVideo();
        }

        function jumpToScene(index) {
          let targetSec = 0;
          for (let i = 0; i < index; i++) {
            targetSec += systemVideoScenes[i].duration;
          }
          elapsedSeconds = targetSec;
          renderScene(index);
          updateTimelineUI();
        }

        function handleScrub(e) {
          const track = document.getElementById('videoScrubberTrack');
          const rect = track.getBoundingClientRect();
          const clickX = e.clientX - rect.left;
          const ratio = Math.max(0, Math.min(1, clickX / rect.width));
          elapsedSeconds = ratio * totalDuration;
          updateTimelineUI();

          let acc = 0;
          for (let i = 0; i < systemVideoScenes.length; i++) {
            acc += systemVideoScenes[i].duration;
            if (elapsedSeconds <= acc) {
              renderScene(i);
              break;
            }
          }
        }

        function updateTimelineUI() {
          const progressPercent = Math.min(100, (elapsedSeconds / totalDuration) * 100);
          const fill = document.getElementById('videoScrubberFill');
          if (fill) fill.style.width = progressPercent + '%';

          const timerEl = document.getElementById('videoTimeDisplay');
          if (timerEl) {
            const curM = String(Math.floor(elapsedSeconds / 60)).padStart(2, '0');
            const curS = String(Math.floor(elapsedSeconds % 60)).padStart(2, '0');
            const totM = String(Math.floor(totalDuration / 60)).padStart(2, '0');
            const totS = String(Math.floor(totalDuration % 60)).padStart(2, '0');
            timerEl.textContent = curM + ':' + curS + ' / ' + totM + ':' + totS;
          }
        }

        function toggleNarrationVoice() {
          isVoiceEnabled = !isVoiceEnabled;
          const icon = document.getElementById('ctlVoiceIcon');
          if (icon) {
            icon.className = isVoiceEnabled ? 'fa-solid fa-volume-high' : 'fa-solid fa-volume-xmark';
          }
          if (!isVoiceEnabled && 'speechSynthesis' in window) {
            window.speechSynthesis.cancel();
          }
        }

        function togglePlayerFullscreen() {
          const container = document.getElementById('saysoftVideoContainer');
          if (!document.fullscreenElement) {
            if (container.requestFullscreen) container.requestFullscreen();
            else if (container.webkitRequestFullscreen) container.webkitRequestFullscreen();
          } else {
            if (document.exitFullscreen) document.exitFullscreen();
          }
        }

        document.addEventListener('DOMContentLoaded', initVideoPlayer);
      </script>

      <!-- معرض صور وشاشات النظام التفاعلي (Interactive Screenshots Gallery) -->
      <% if (system.Images && system.Images.length > 0) { %>
        <div class="card" style="padding: 30px; margin-bottom: 30px;" id="system-gallery">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; border-bottom: 1px solid var(--border-color); padding-bottom: 12px;">
            <div>
              <h3 style="font-size: 18px; font-weight: 800; margin: 0 0 4px; color: var(--text-main);">
                <i class="fa-solid fa-images" style="color: var(--primary-color);"></i> <%= t('معرض واجهات وشاشات النظام', 'System UI & Screenshots Gallery') %>
              </h3>
              <p style="font-size: 13px; color: var(--text-muted); margin: 0;">
                <%= t('استعرض الواجهات الفعلية للبرمجية، انقر على أي صورة لتكبيرها واستعراضها بجودة عالية', 'Click any screenshot to expand in full high-definition view') %>
              </p>
            </div>
            <span style="font-size: 12px; font-weight: 700; padding: 3px 10px; border-radius: 20px; background: var(--primary-light); color: var(--primary-color);">
              <%= system.Images.length %> <%= t('شاشات معتمدة', 'Screenshots') %>
            </span>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 18px;">
            <% system.Images.forEach((img, idx) => { %>
              <div class="gallery-card" onclick="openLightbox(<%= idx %>)" style="cursor: pointer; border-radius: 10px; overflow: hidden; border: 1px solid var(--border-color); background: var(--bg-color); transition: transform 0.2s ease, box-shadow 0.2s ease;">
                <div style="position: relative; overflow: hidden; line-height: 0; background: #0b1120;">
                  <img src="<%= img.ImagePath %>" alt="<%= (lang === 'en' ? img.CaptionEn : img.CaptionAr) || 'Screenshot' %>" 
                       style="width: 100%; height: 165px; object-fit: cover; transition: transform 0.3s ease;">
                  <div class="gallery-hover-overlay" style="position: absolute; inset: 0; background: rgba(0,0,0,0.4); display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.2s ease;">
                    <span style="background: rgba(255,255,255,0.9); color: #0f172a; font-size: 12px; font-weight: 700; padding: 6px 14px; border-radius: 20px;">
                      <i class="fa-solid fa-expand"></i> <%= t('تكبير', 'Expand') %>
                    </span>
                  </div>
                </div>
                <% if (img.CaptionAr || img.CaptionEn) { %>
                  <div style="padding: 10px 14px; font-size: 13px; font-weight: 700; color: var(--text-main); border-top: 1px solid var(--border-color); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= lang === 'en' ? (img.CaptionEn || img.CaptionAr) : img.CaptionAr %>
                  </div>
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>

        <!-- مودال تكبير الصور (Lightbox Modal) -->
        <div id="galleryLightbox" style="display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(0, 0, 0, 0.88); backdrop-filter: blur(5px); align-items: center; justify-content: center; flex-direction: column; padding: 20px;">
          <div style="position: absolute; top: 20px; right: 25px; display: flex; gap: 15px;">
            <button onclick="closeLightbox()" style="background: rgba(255,255,255,0.15); border: none; color: #fff; width: 44px; height: 44px; border-radius: 50%; font-size: 20px; cursor: pointer;">
              <i class="fa-solid fa-xmark"></i>
            </button>
          </div>

          <div style="max-width: 95vw; max-height: 80vh; position: relative; display: flex; align-items: center; justify-content: center;">
            <button onclick="prevLightboxImage()" style="position: absolute; right: -25px; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.2); border: none; color: #fff; width: 46px; height: 46px; border-radius: 50%; font-size: 20px; cursor: pointer; z-index: 10;">
              <i class="fa-solid fa-chevron-right"></i>
            </button>

            <img id="lightboxImg" src="" alt="Enlarged Screenshot" style="max-width: 100%; max-height: 75vh; border-radius: 10px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); border: 2px solid rgba(255,255,255,0.2);">

            <button onclick="nextLightboxImage()" style="position: absolute; left: -25px; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.2); border: none; color: #fff; width: 46px; height: 46px; border-radius: 50%; font-size: 20px; cursor: pointer; z-index: 10;">
              <i class="fa-solid fa-chevron-left"></i>
            </button>
          </div>

          <div id="lightboxCaption" style="color: #f8fafc; font-size: 15px; font-weight: 700; margin-top: 14px; text-align: center; max-width: 700px;"></div>
        </div>

        <style>
          .gallery-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-md);
          }
          .gallery-card:hover .gallery-hover-overlay {
            opacity: 1 !important;
          }
          .gallery-card:hover img {
            transform: scale(1.04);
          }
        </style>

        <script>
          const galleryImagesData = <%- JSON.stringify(system.Images) %>;
          let currentLightboxIndex = 0;

          function openLightbox(index) {
            currentLightboxIndex = index;
            updateLightboxView();
            const modal = document.getElementById('galleryLightbox');
            modal.style.display = 'flex';
            document.body.style.overflow = 'hidden';
          }

          function closeLightbox() {
            const modal = document.getElementById('galleryLightbox');
            modal.style.display = 'none';
            document.body.style.overflow = '';
          }

          function prevLightboxImage() {
            if (currentLightboxIndex > 0) {
              currentLightboxIndex--;
            } else {
              currentLightboxIndex = galleryImagesData.length - 1;
            }
            updateLightboxView();
          }

          function nextLightboxImage() {
            if (currentLightboxIndex < galleryImagesData.length - 1) {
              currentLightboxIndex++;
            } else {
              currentLightboxIndex = 0;
            }
            updateLightboxView();
          }

          function updateLightboxView() {
            const imgData = galleryImagesData[currentLightboxIndex];
            if (imgData) {
              document.getElementById('lightboxImg').src = imgData.ImagePath;
              const caption = "<%= lang %>" === 'en' ? (imgData.CaptionEn || imgData.CaptionAr) : (imgData.CaptionAr || imgData.CaptionEn);
              document.getElementById('lightboxCaption').textContent = caption || '';
            }
          }

          // إغلاق عبر زر الهروب ESC
          document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowRight') prevLightboxImage();
            if (e.key === 'ArrowLeft') nextLightboxImage();
          });
        </script>
      <% } %>

      <!-- الأسئلة الشائعة الخاصة بالمنظومة -->
      <% if (system.FAQs && system.FAQs.length > 0) { %>
        <div class="card" style="padding: 30px; margin-bottom: 30px;">
          <h3 style="font-size: 18px; font-weight: 700; margin-bottom: 16px; color: var(--text-main);">
            <i class="fa-solid fa-circle-question"></i> <%= t('أسئلة شائعة حول المنظومة', 'Frequently Asked Questions') %>
          </h3>
          <div style="display: flex; flex-direction: column; gap: 12px;">
            <% system.FAQs.forEach(faq => { %>
              <details style="border: 1px solid var(--border-color); border-radius: 8px; padding: 14px 18px; background: var(--bg-color); cursor: pointer;">
                <summary style="font-weight: 700; font-size: 15px; color: var(--text-main);">
                  <%= lang === 'en' ? faq.QuestionEn : faq.QuestionAr %>
                </summary>
                <div style="margin-top: 10px; font-size: 14px; color: var(--text-muted); line-height: 1.7; border-top: 1px solid var(--border-color); padding-top: 10px;">
                  <%= lang === 'en' ? faq.AnswerEn : faq.AnswerAr %>
                </div>
              </details>
            <% }) %>
          </div>
        </div>
      <% } %>

    </div>

    <!-- العمود الأيسر (الباقات، السعر، الإضافة للسلة، الاستفسار) -->
    <div style="display: flex; flex-direction: column; gap: 25px;">
      
      <!-- كارت الباقات والاشتراك -->
