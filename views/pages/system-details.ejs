              <div style="border: 1px solid var(--border-color); border-radius: 12px; padding: 16px; background: var(--card-bg); position: relative;">
                <% if (pkg.IsPopular) { %>
                  <span style="position: absolute; top: -10px; left: 15px; background: #f59e0b; color: white; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 10px;">
                    <%= t('الأكثر طلباً', 'Most Popular') %>
                  </span>
                <% } %>

                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8px;">
