<%- include('../partials/admin_header') %>

<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
  <div>
    <h1 style="font-size: 24px; font-weight: 800; color: #0f172a; margin-bottom: 4px;">
      <%= isEdit ? `تعديل المنظومة: ${system.NameAr}` : 'إضافة منظومة جديدة' %>
    </h1>
    <p style="color: #64748b; font-size: 14px;">أدخل بيانات المنظومة باللغتين العربية والإنجليزية وحدد باقات الأسعار والوسائط</p>
  </div>

  <a href="/admin/systems" class="btn btn-outline">
    <i class="fa-solid fa-arrow-right"></i> العودة للمنظومات
  </a>
</div>

<form action="<%= isEdit ? `/admin/systems/edit/${system.IDSystem}` : '/admin/systems/new' %>" method="POST" enctype="multipart/form-data" id="systemForm">

  <!-- التبويبات العلوية -->
  <div class="tabs-header">
    <button type="button" class="tab-btn active" onclick="switchTab('tab-general', this)">
      <i class="fa-solid fa-circle-info"></i> البيانات الأساسية
    </button>
    <button type="button" class="tab-btn" onclick="switchTab('tab-owner', this)" style="color: #b45309; font-weight: 700;">
      <i class="fa-solid fa-key"></i> بيانات إدارة المالك (سري)
    </button>
    <button type="button" class="tab-btn" onclick="switchTab('tab-description', this)">
      <i class="fa-solid fa-align-right"></i> الشرح والمميزات
    </button>
    <button type="button" class="tab-btn" onclick="switchTab('tab-packages', this)">
      <i class="fa-solid fa-tags"></i> الباقات والأسعار
    </button>
    <button type="button" class="tab-btn" onclick="switchTab('tab-faqs', this)">
      <i class="fa-solid fa-circle-question"></i> الأسئلة الشائعة
    </button>
    <button type="button" class="tab-btn" onclick="switchTab('tab-gallery', this)">
      <i class="fa-solid fa-images"></i> معرض الصور والشاشات
    </button>
    <button type="button" class="tab-btn" onclick="switchTab('tab-seo', this)">
      <i class="fa-solid fa-magnifying-glass-chart"></i> تحسين محركات البحث (SEO)
    </button>
  </div>

  <!-- التبويب 1: البيانات الأساسية -->
  <div id="tab-general" class="tab-content table-container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
      <div class="form-group">
        <label>اسم المنظومة (بالعربية) *</label>
        <input type="text" name="nameAr" class="form-control" required value="<%= system ? system.NameAr : '' %>" placeholder="مثال: منظومة ساي جارد الأمنية">
      </div>

      <div class="form-group">
        <label>اسم المنظومة (بالإنجليزية) *</label>
        <input type="text" name="nameEn" class="form-control" required value="<%= system ? system.NameEn : '' %>" placeholder="Example: SayGuard Security System">
      </div>

      <div class="form-group">
        <label style="color: #0284c7; font-weight: 700;">
          <i class="fa-solid fa-tag"></i> الاسم التجاري للمنظومة (بالعربية)
        </label>
        <input type="text" name="brandNameAr" class="form-control" value="<%= system && system.BrandNameAr ? system.BrandNameAr : '' %>" placeholder="مثال: ساي جارد (SayGuard)">
        <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">الاسم التجاري المتميز للتطبيق</small>
      </div>

      <div class="form-group">
        <label style="color: #0284c7; font-weight: 700;">
          <i class="fa-solid fa-tag"></i> الاسم التجاري للمنظومة (بالإنجليزية)
        </label>
        <input type="text" name="brandNameEn" class="form-control" value="<%= system && system.BrandNameEn ? system.BrandNameEn : '' %>" placeholder="Example: SayGuard" style="direction: ltr;">
        <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">Commercial Brand Name in English</small>
      </div>

      <div class="form-group">
        <label style="color: #0f172a; font-weight: 700;">
          <i class="fa-solid fa-ethernet" style="color: #64748b;"></i> الرقم الكودي للتطبيق (البورت المحلي - 5 أرقام) *
        </label>
        <input type="text" name="appCode" class="form-control" maxlength="5" pattern="[0-9]{5}" value="<%= system && system.AppCode ? system.AppCode : '' %>" placeholder="مثال: 50010" style="direction: ltr; font-family: monospace; font-weight: 700;">
        <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">رقم مكون من 5 أرقام يمثل رقم المنفذ/البورت في بيئة العمل المحلي (Localhost Port)</small>
      </div>

      <div class="form-group">
        <label style="color: #0f172a; font-weight: 700;">
          <i class="fa-solid fa-layer-group" style="color: #64748b;"></i> نوع التطبيق (Application Architecture) *
        </label>
        <select name="appType" class="form-control" required style="font-weight: 700;">
          <option value="SAAS_CLOUD" <%= (!system || system.AppType === 'SAAS_CLOUD') ? 'selected' : '' %>>☁️ تطبيق سحابي بنظام اشتراكات (SaaS Web App)</option>
          <option value="DESKTOP_APP" <%= (system && system.AppType === 'DESKTOP_APP') ? 'selected' : '' %>>💻 تطبيق سطح مكتب (Desktop Application)</option>
          <option value="MOBILE_APP" <%= (system && system.AppType === 'MOBILE_APP') ? 'selected' : '' %>>📱 تطبيق جوال محمول (Mobile App - iOS / Android)</option>
          <option value="WEB_APP" <%= (system && system.AppType === 'WEB_APP') ? 'selected' : '' %>>🌐 تطبيق ويب مستقل ومخصص (Dedicated Web App)</option>
          <option value="HYBRID_SUITE" <%= (system && system.AppType === 'HYBRID_SUITE') ? 'selected' : '' %>>🔄 منظومة هجينة متكاملة (Hybrid System - Web & Mobile & Desktop)</option>
        </select>
        <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">بنية المنظومة وطريقة تشغيلها المعتمدة</small>
      </div>

      <div class="form-group">
        <label>الرابط اللطيف (Slug) *</label>
        <input type="text" name="slug" class="form-control" required value="<%= system ? system.Slug : '' %>" placeholder="sayguard" style="direction: ltr; text-align: left;">
      </div>

      <div class="form-group">
        <label>قطاع الأعمال والتصنيف *</label>
        <select name="sectorId" class="form-control" required>
          <% sectors.forEach(sec => { %>
            <option value="<%= sec.IDSector %>" <%= (system && system.SectorID == sec.IDSector) ? 'selected' : '' %>>
              <%= sec.NameAr %> (<%= sec.NameEn %>)
            </option>
          <% }) %>
        </select>
      </div>

      <div class="form-group">
        <label>حالة المنتج *</label>
        <select name="productStatus" class="form-control" required style="font-weight: 700;">
          <option value="PUBLISHED" <%= (!system || system.ProductStatus === 'PUBLISHED') ? 'selected' : '' %>>🟢 منشور</option>
          <option value="IN_PRODUCTION" <%= (system && system.ProductStatus === 'IN_PRODUCTION') ? 'selected' : '' %>>🚀 قيد الإنتاج</option>
          <option value="IN_DEVELOPMENT" <%= (system && system.ProductStatus === 'IN_DEVELOPMENT') ? 'selected' : '' %>>💻 قيد التطوير</option>
          <option value="UNDER_STUDY" <%= (system && system.ProductStatus === 'UNDER_STUDY') ? 'selected' : '' %>>📋 قيد الدراسة</option>
          <option value="COMING_SOON" <%= (system && system.ProductStatus === 'COMING_SOON') ? 'selected' : '' %>>⏳ قريباً</option>
        </select>
      </div>

      <div class="form-group" style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 12px;">
        <label style="color: #0f172a; font-weight: 800; font-size: 13.5px; margin-bottom: 6px; display: block;">
          <i class="fa-solid fa-eye" style="color: #0284c7;"></i> حالة ظهور المنظومة في الكتالوج والموقع *
        </label>
        <select name="isActive" class="form-control" required style="font-weight: 700; height: 42px;">
          <option value="true" <%= (!system || system.IsActive !== false) ? 'selected' : '' %>>🟢 ظاهرة في الكتالوج والموقع</option>
          <option value="false" <%= (system && system.IsActive === false) ? 'selected' : '' %>>🔒 مخفي (قيد التجهيز - لا تظهر في الموقع)</option>
        </select>
        <small style="color: #64748b; font-size: 11.5px; display: block; margin-top: 4px;">
          عند تحديد "مخفي"، لن تظهر المنظومة لمتصفحي وزوار الموقع وتتاح فقط للمسؤولين لمواصلة العمل عليها وتجهيزها داخلياً.
        </small>
      </div>

      <div class="form-group">
        <label>رابط الوصول لتجربة التطبيق (Live Demo URL)</label>
        <input type="url" name="demoUrl" class="form-control" value="<%= system && system.DemoUrl ? system.DemoUrl : '' %>" placeholder="https://demo.saysoft.tech/..." style="direction: ltr; text-align: left;">
        <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">رابط تجربة التطبيق المباشرة المتاح للزوار والعملاء في صفحة المنتج والكتالوج</small>
      </div>

      <div class="form-group">
        <label>رابط فيديو يوتيوب المدمج (اختياري)</label>
        <input type="url" name="youtubeUrl" class="form-control" value="<%= system && system.YoutubeUrl ? system.YoutubeUrl : '' %>" placeholder="https://www.youtube.com/watch?v=..." style="direction: ltr; text-align: left;">
      </div>
    </div>

    <!-- رفع الشعار وشعار التطبيق والصورة الرئيسية للمنتج -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; margin-top: 15px; padding-top: 15px; border-top: 1px solid #e2e8f0;">
      
      <!-- شعار المنظومة المربع العام -->
      <div class="form-group">
        <label>شعار المنظومة العام (Logo)</label>
        <div style="display: flex; align-items: center; gap: 15px; margin-top: 8px;">
          <% if (system && system.Logo) { %>
            <img src="<%= system.Logo %>" alt="Current Logo" style="width: 55px; height: 55px; border-radius: 10px; object-fit: cover; border: 1px solid #cbd5e1; background: #fff; padding: 2px;">
            <input type="hidden" name="existingLogo" value="<%= system.Logo %>">
          <% } %>
          <input type="file" name="logo" class="form-control" accept="image/*">
        </div>
        <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">شعار المنظومة العام المربع</small>
      </div>

      <!-- شعار التطبيق المخصص لبطاقات التطبيق -->
      <div class="form-group">
        <label style="font-weight: 700; color: #0284c7;">
          <i class="fa-solid fa-icons"></i> شعار التطبيق المخصص للبطاقات (App Logo)
        </label>
        <div style="display: flex; align-items: center; gap: 15px; margin-top: 8px;">
          <% if (system && system.AppLogo) { %>
            <img src="<%= system.AppLogo %>" alt="App Logo" style="width: 55px; height: 55px; border-radius: 10px; object-fit: cover; border: 1px solid #cbd5e1; background: #fff; padding: 2px;">
            <input type="hidden" name="existingAppLogo" value="<%= system.AppLogo %>">
          <% } else if (system && system.Logo) { %>
            <input type="hidden" name="existingAppLogo" value="<%= system.Logo %>">
          <% } %>
          <input type="file" name="appLogo" class="form-control" accept="image/*">
        </div>
        <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">شعار خاص بالتطبيق يظهر في بطاقات الكتالوج والصفحة الرئيسية</small>
      </div>

      <!-- الصورة الرئيسية للمنتج -->
      <div class="form-group">
        <label style="font-weight: 700; color: #0284c7;">
          <i class="fa-solid fa-image"></i> الصورة الرئيسية للمنتج (Main Cover)
        </label>
        <div style="display: flex; align-items: center; gap: 15px; margin-top: 8px;">
          <% if (system && system.CoverImage) { %>
            <div style="position: relative; width: 100px; height: 55px; border-radius: 8px; overflow: hidden; border: 1px solid #cbd5e1; flex-shrink: 0;">
              <img src="<%= system.CoverImage %>" alt="Cover Image" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <input type="hidden" name="existingCoverImage" value="<%= system.CoverImage %>">
          <% } %>
          <input type="file" name="coverImage" class="form-control" accept="image/*">
        </div>
        <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">الصورة البانورامية العريضة لصفحة تفاصيل المنتج (16:9)</small>
      </div>
    </div>

    <div class="form-group" style="margin-top: 20px;">
      <label>نبذة تسويقية سريعة (بالعربية) *</label>
      <textarea name="summaryAr" class="form-control" rows="2" required placeholder="نبذة موجزة تظهر في الكروت والصفحة الرئيسية..."><%= system ? system.SummaryAr : '' %></textarea>
    </div>

    <div class="form-group">
      <label>نبذة تسويقية سريعة (بالإنجليزية) *</label>
      <textarea name="summaryEn" class="form-control" rows="2" required placeholder="Brief summary for cards..." style="direction: ltr;"><%= system ? system.SummaryEn : '' %></textarea>
    </div>

    <div class="form-group" style="margin-top: 10px;">
      <label style="display: flex; align-items: center; gap: 10px; cursor: pointer;">
        <input type="checkbox" name="isFeatured" value="true" <%= (system && system.IsFeatured) ? 'checked' : '' %> style="width: 18px; height: 18px;">
        <span style="font-weight: 700; color: #0284c7;">تثبيت كمنظومة مميزة (تظهر في الصفحة الرئيسية للموقع)</span>
      </label>
    </div>
  </div>

  <!-- التبويب الجديد: بيانات إدارة المالك (سري وخاص بالإدارة فقط) -->
  <div id="tab-owner" class="tab-content table-container" style="display: none;">
    <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 10px; padding: 14px 18px; margin-bottom: 22px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
      <div style="display: flex; align-items: center; gap: 12px;">
        <i class="fa-solid fa-shield-halved" style="font-size: 22px; color: #d97706;"></i>
        <div>
          <div style="font-weight: 800; font-size: 14px; color: #92400e;">بيانات إدارة لوحة تحكم مالك المنظومة (سري)</div>
          <div style="font-size: 12.5px; color: #b45309; margin-top: 2px;">هذه البيانات مخصصة لمديري النظام فقط ولا تظهر للمستخدمين أو الزوار في الموقع العام إطلاقاً.</div>
        </div>
      </div>
      <a href="/admin/systems/credentials" target="_blank" class="btn btn-outline btn-sm" style="font-size: 12px; background: #fff;">
        <i class="fa-solid fa-key"></i> استعراض سجل الحسابات الكامل ↗
      </a>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
      
      <!-- رابط لوحة تحكم المالك -->
      <div class="form-group">
        <label style="font-weight: 700; color: #0f172a;">
          <i class="fa-solid fa-link" style="color: #0284c7;"></i> رابط لوحة تحكم/إدارة المالك (Owner Admin URL)
        </label>
        <div style="display: flex; gap: 8px;">
          <input type="url" name="ownerAdminUrl" class="form-control" value="<%= system && system.OwnerAdminUrl ? system.OwnerAdminUrl : '' %>" placeholder="http://localhost:50010/admin أو رابط السيرفر" style="direction: ltr; font-family: monospace;">
          <% if (system && system.OwnerAdminUrl) { %>
            <a href="<%= system.OwnerAdminUrl %>" target="_blank" class="btn btn-outline" style="flex-shrink: 0; padding: 8px 12px;" title="فتح الرابط">
              <i class="fa-solid fa-arrow-up-right-from-square"></i>
            </a>
          <% } %>
        </div>
        <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">رابط دخول لوحة تحكم المنظومة الخاص بمالك النظام</small>
      </div>

      <!-- اسم مستخدم المالك -->
      <div class="form-group">
        <label style="font-weight: 700; color: #0f172a;">
          <i class="fa-solid fa-user-lock" style="color: #0284c7;"></i> اسم مستخدم المالك (Owner Username)
        </label>
        <input type="text" name="ownerUsername" class="form-control" value="<%= system && system.OwnerUsername ? system.OwnerUsername : '' %>" placeholder="مثال: admin_owner" style="direction: ltr; font-family: monospace;">
        <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">اسم الدخول المعتمد للوحة إدارة المالك</small>
      </div>

      <!-- كلمة مرور المالك مع زر إظهار/إخفاء -->
      <div class="form-group">
        <label style="font-weight: 700; color: #0f172a;">
          <i class="fa-solid fa-key" style="color: #f59e0b;"></i> كلمة مرور المالك (Owner Password)
        </label>
        <div style="position: relative; display: flex; align-items: center;">
          <input type="password" id="ownerPasswordInput" name="ownerPassword" class="form-control" value="<%= system && system.OwnerPassword ? system.OwnerPassword : '' %>" placeholder="••••••••" style="direction: ltr; font-family: monospace; padding-left: 45px;">
          <button type="button" onclick="toggleOwnerPasswordVisibility()" style="position: absolute; left: 10px; background: transparent; border: none; color: #64748b; cursor: pointer; padding: 4px 8px; font-size: 15px;" title="إظهار / إخفاء كلمة المرور">
            <i id="ownerPasswordEyeIcon" class="fa-solid fa-eye"></i>
          </button>
        </div>
        <small style="color: #64748b; font-size: 12px; display: block; margin-top: 4px;">كلمة مرور لوحة تحكم المالك (انقر على أيقونة العين لإظهارها)</small>
      </div>

      <!-- ملاحظات مالك المنظومة -->
      <div class="form-group" style="grid-column: 1 / -1;">
        <label style="font-weight: 700; color: #0f172a;">
          <i class="fa-solid fa-notes-medical" style="color: #64748b;"></i> ملاحظات سرية إضافية لإدارة المالك
        </label>
        <textarea name="ownerNotes" class="form-control" rows="2" placeholder="أي بيانات أو منافذ أو تعليمات دخول خاصة بمالك المنظومة..."><%= system && system.OwnerNotes ? system.OwnerNotes : '' %></textarea>
      </div>

    </div>
  </div>

  <script>
  function toggleOwnerPasswordVisibility() {
    const input = document.getElementById('ownerPasswordInput');
    const icon = document.getElementById('ownerPasswordEyeIcon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.classList.remove('fa-eye');
      icon.classList.add('fa-eye-slash');
      icon.style.color = '#ef4444';
    } else {
      input.type = 'password';
      icon.classList.remove('fa-eye-slash');
      icon.classList.add('fa-eye');
      icon.style.color = '#64748b';
    }
  }
  </script>

  <!-- التبويب 2: الشرح والمميزات -->
  <div id="tab-description" class="tab-content table-container" style="display: none;">
    <div class="form-group">
      <label>الشرح الكامل والمميزات (بالعربية - يدعم تنسيق HTML)</label>
      <textarea name="descriptionAr" class="form-control" rows="12" placeholder="اكتب شرحاً مفصلاً للنظام ومميزاته الفنية والإدارية..."><%= system ? system.DescriptionAr : '' %></textarea>
    </div>

    <div class="form-group">
      <label>الشرح الكامل والمميزات (بالإنجليزية - يدعم تنسيق HTML)</label>
      <textarea name="descriptionEn" class="form-control" rows="12" placeholder="Detailed features and description in English..." style="direction: ltr;"><%= system ? system.DescriptionEn : '' %></textarea>
    </div>
  </div>

  <!-- التبويب 3: باقات الاشتراك والأسعار -->
  <div id="tab-packages" class="tab-content table-container" style="display: none;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
      <div>
        <h3 style="font-size: 16px; font-weight: 700; color: #0f172a;">باقات الاشتراك والأسعار</h3>
        <p style="font-size: 13px; color: #64748b;">أضف باقات متعددة (مثال: شهري، سنوي، نسخة مستقلة LifeTime)</p>
      </div>
      <button type="button" class="btn btn-outline btn-sm" onclick="addPackageRow()">
        <i class="fa-solid fa-plus"></i> إضافة باقة
      </button>
    </div>

    <div id="packagesContainer" style="display: flex; flex-direction: column; gap: 15px;">
      <!-- سيتم تحميل الباقات هنا ديناميكياً -->
    </div>
    <input type="hidden" name="packagesJson" id="packagesJson">
  </div>

  <!-- التبويب 4: الأسئلة الشائعة -->
  <div id="tab-faqs" class="tab-content table-container" style="display: none;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px;">
      <div>
        <h3 style="font-size: 16px; font-weight: 700; color: #0f172a;">الأسئلة الشائعة الخاصة بالمنظومة</h3>
        <p style="font-size: 13px; color: #64748b;">تظهر في صفحة تفاصيل المنظومة لإرشاد العميل</p>
      </div>
      <button type="button" class="btn btn-outline btn-sm" onclick="addFaqRow()">
        <i class="fa-solid fa-plus"></i> إضافة سؤال وجواب
      </button>
    </div>

    <div id="faqsContainer" style="display: flex; flex-direction: column; gap: 15px;">
      <!-- سيتم تحميل الأسئلة هنا ديناميكياً -->
    </div>
    <input type="hidden" name="faqsJson" id="faqsJson">
  </div>

  <!-- التبويب 5: معرض الصور والشاشات -->
  <div id="tab-gallery" class="tab-content table-container" style="display: none;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
      <div>
        <h3 style="font-size: 16px; font-weight: 700; color: #0f172a;">معرض واجهات وشاشات النظام (Screenshots)</h3>
        <p style="font-size: 13px; color: #64748b;">إدارة الشاشات التوضيحية لواجهات المنظومة، يمكن رفع صور جديدة أو تحديد مسارات وروابط معتمدة</p>
      </div>
      <div>
        <button type="button" class="btn btn-outline btn-sm" onclick="addImageRow()">
          <i class="fa-solid fa-plus"></i> إضافة مسار صورة
        </button>
      </div>
    </div>

    <!-- رفع ملفات صور جديدة مباشرة -->
    <div style="background: #f8fafc; border: 2px dashed #cbd5e1; border-radius: 10px; padding: 20px; text-align: center; margin-bottom: 22px;">
      <i class="fa-solid fa-cloud-arrow-up" style="font-size: 32px; color: #0284c7; margin-bottom: 8px;"></i>
      <div style="font-weight: 700; font-size: 14px; margin-bottom: 4px; color: #0f172a;">رفع صور وشاشات جديدة من جهازك</div>
      <p style="font-size: 12px; color: #64748b; margin-bottom: 12px;">يمكنك اختيار صورة واحدة أو صور متعددة معاً (PNG, JPG, WEBP, SVG)</p>
      <input type="file" name="screenshots" multiple accept="image/*" class="form-control" style="max-width: 400px; margin: 0 auto;">
    </div>

    <div id="imagesContainer" style="display: flex; flex-direction: column; gap: 15px;">
      <!-- سيتم تحميل الصور هنا ديناميكياً -->
    </div>
    <input type="hidden" name="imagesJson" id="imagesJson">
  </div>

  <!-- التبويب 6: الـ SEO -->
  <div id="tab-seo" class="tab-content table-container" style="display: none;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
      <div class="form-group">
        <label>عنوان السيو (Meta Title - عربي)</label>
        <input type="text" name="metaTitleAr" class="form-control" value="<%= system && system.MetaTitleAr ? system.MetaTitleAr : '' %>">
      </div>
      <div class="form-group">
        <label>عنوان السيو (Meta Title - إنجليزي)</label>
        <input type="text" name="metaTitleEn" class="form-control" value="<%= system && system.MetaTitleEn ? system.MetaTitleEn : '' %>" style="direction: ltr;">
      </div>

      <div class="form-group">
        <label>وصف السيو (Meta Description - عربي)</label>
        <textarea name="metaDescAr" class="form-control" rows="3"><%= system && system.MetaDescAr ? system.MetaDescAr : '' %></textarea>
      </div>
      <div class="form-group">
        <label>وصف السيو (Meta Description - إنجليزي)</label>
        <textarea name="metaDescEn" class="form-control" rows="3" style="direction: ltr;"><%= system && system.MetaDescEn ? system.MetaDescEn : '' %></textarea>
      </div>

      <div class="form-group">
        <label>الكلمات المفتاحية (Meta Keywords - عربي)</label>
        <input type="text" name="metaKeywordsAr" class="form-control" value="<%= system && system.MetaKeywordsAr ? system.MetaKeywordsAr : '' %>" placeholder="منظومة سحابية, إدارة...">
      </div>
      <div class="form-group">
        <label>الكلمات المفتاحية (Meta Keywords - إنجليزي)</label>
        <input type="text" name="metaKeywordsEn" class="form-control" value="<%= system && system.MetaKeywordsEn ? system.MetaKeywordsEn : '' %>" placeholder="saas, cloud system..." style="direction: ltr;">
      </div>
    </div>
  </div>

  <!-- شريط الحفظ السفلي -->
  <div style="margin-top: 25px; display: flex; justify-content: flex-end; gap: 14px;">
    <a href="/admin/systems" class="btn btn-outline">إلغاء</a>
    <button type="submit" class="btn btn-primary" style="padding: 12px 35px; font-size: 15px;">
      <i class="fa-solid fa-floppy-disk"></i> <%= isEdit ? 'حفظ التعديلات' : 'حفظ ونشر المنظومة' %>
    </button>
  </div>

</form>

<script>
  // البيانات الأولية للباقات والأسئلة والصور إن وجدت
  let existingPackages = <%- system && system.Packages ? JSON.stringify(system.Packages) : '[]' %>;
  let existingFaqs = <%- system && system.FAQs ? JSON.stringify(system.FAQs) : '[]' %>;
  let existingImages = <%- system && system.Images ? JSON.stringify(system.Images) : '[]' %>;

  function renderPackages() {
    const container = document.getElementById('packagesContainer');
    container.innerHTML = '';

    if (existingPackages.length === 0) {
      container.innerHTML = '<div style="color: #64748b; font-size: 13px; text-align: center; padding: 20px;">لم تقم بإضافة أي باقات بعد. اضغط على "إضافة باقة" لإضافة خطة أسعار.</div>';
      return;
    }

    existingPackages.forEach((pkg, index) => {
      const div = document.createElement('div');
      div.style.cssText = 'border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; background: #f8fafc; position: relative;';
      div.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
          <strong style="color: #0284c7; font-size: 14px;">الباقة #${index + 1}</strong>
          <button type="button" class="btn btn-outline btn-sm" style="color: #dc2626; border-color: #fca5a5;" onclick="removePackage(${index})">
            <i class="fa-solid fa-trash"></i> حذف
          </button>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; margin-bottom: 12px;">
          <div>
            <label style="font-size: 12px; font-weight: 700;">اسم الباقة (عربي) *</label>
            <input type="text" class="form-control" value="${pkg.NameAr || pkg.nameAr || ''}" onchange="updatePkg(${index}, 'nameAr', this.value)" placeholder="الباقة السنوية">
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 700;">اسم الباقة (إنجليزي) *</label>
            <input type="text" class="form-control" value="${pkg.NameEn || pkg.nameEn || ''}" onchange="updatePkg(${index}, 'nameEn', this.value)" placeholder="Annual Plan" style="direction: ltr;">
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 700;">السعر (${'<%= settings.PrimaryCurrency || "USD" %>'}) *</label>
            <input type="number" step="0.01" class="form-control" value="${pkg.Price || pkg.price || ''}" onchange="updatePkg(${index}, 'price', this.value)" placeholder="299">
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 700;">دورية الاشتراك</label>
            <select class="form-control" onchange="updatePkg(${index}, 'period', this.value)">
              <option value="MONTHLY" ${(pkg.Period === 'MONTHLY' || pkg.period === 'MONTHLY') ? 'selected' : ''}>شهري</option>
              <option value="YEARLY" ${(pkg.Period === 'YEARLY' || pkg.period === 'YEARLY' || !pkg.Period) ? 'selected' : ''}>سنوي</option>
              <option value="LIFETIME" ${(pkg.Period === 'LIFETIME' || pkg.period === 'LIFETIME') ? 'selected' : ''}>نسخة دائمة (LifeTime)</option>
            </select>
          </div>
        </div>
        <div>
          <label style="font-size: 12px; font-weight: 700;">المميزات (مفصولة بفواصل)</label>
          <input type="text" class="form-control" value="${pkg.FeaturesAr || pkg.featuresAr || ''}" onchange="updatePkg(${index}, 'featuresAr', this.value)" placeholder="مستخدمين غير محدودين, دعم فني 24/7...">
        </div>
      `;
      container.appendChild(div);
    });
  }

  function addPackageRow() {
    existingPackages.push({
      nameAr: 'باقة جديدة',
      nameEn: 'New Plan',
      price: 100,
      period: 'YEARLY',
      featuresAr: 'تحديثات مجانية, دعم فني',
      featuresEn: 'Free updates, Technical support',
      isPopular: false
    });
    renderPackages();
  }

  function removePackage(index) {
    existingPackages.splice(index, 1);
    renderPackages();
  }

  function updatePkg(index, key, val) {
    existingPackages[index][key] = val;
  }

  // دوال الأسئلة الشائعة
  function renderFaqs() {
    const container = document.getElementById('faqsContainer');
    container.innerHTML = '';

    if (existingFaqs.length === 0) {
      container.innerHTML = '<div style="color: #64748b; font-size: 13px; text-align: center; padding: 20px;">لم تقم بإضافة أسئلة شائعة بعد. اضغط على "إضافة سؤال وجواب".</div>';
      return;
    }

    existingFaqs.forEach((faq, index) => {
      const div = document.createElement('div');
      div.style.cssText = 'border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; background: #f8fafc;';
      div.innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
          <strong style="color: #0284c7; font-size: 14px;">سؤال #${index + 1}</strong>
          <button type="button" class="btn btn-outline btn-sm" style="color: #dc2626; border-color: #fca5a5;" onclick="removeFaq(${index})">
            <i class="fa-solid fa-trash"></i> حذف
          </button>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 10px;">
          <div>
            <label style="font-size: 12px; font-weight: 700;">السؤال (عربي)</label>
            <input type="text" class="form-control" value="${faq.QuestionAr || faq.questionAr || ''}" onchange="updateFaq(${index}, 'questionAr', this.value)">
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 700;">السؤال (إنجليزي)</label>
            <input type="text" class="form-control" value="${faq.QuestionEn || faq.questionEn || ''}" onchange="updateFaq(${index}, 'questionEn', this.value)" style="direction: ltr;">
          </div>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
          <div>
            <label style="font-size: 12px; font-weight: 700;">الإجابة (عربي)</label>
            <textarea class="form-control" rows="2" onchange="updateFaq(${index}, 'answerAr', this.value)">${faq.AnswerAr || faq.answerAr || ''}</textarea>
          </div>
          <div>
            <label style="font-size: 12px; font-weight: 700;">الإجابة (إنجليزي)</label>
            <textarea class="form-control" rows="2" onchange="updateFaq(${index}, 'answerEn', this.value)" style="direction: ltr;">${faq.AnswerEn || faq.answerEn || ''}</textarea>
          </div>
        </div>
      `;
      container.appendChild(div);
    });
  }

  function addFaqRow() {
    existingFaqs.push({
      questionAr: '',
      questionEn: '',
      answerAr: '',
      answerEn: ''
    });
    renderFaqs();
  }

  function removeFaq(index) {
    existingFaqs.splice(index, 1);
    renderFaqs();
  }

  function updateFaq(index, key, val) {
    existingFaqs[index][key] = val;
  }

  // دوال إدارة معرض الصور والشاشات
  function renderImages() {
    const container = document.getElementById('imagesContainer');
    if (!container) return;
    container.innerHTML = '';

    if (existingImages.length === 0) {
      container.innerHTML = '<div style="color: #64748b; font-size: 13px; text-align: center; padding: 20px; background: #f8fafc; border-radius: 8px;">لا توجد صور مضافة في المعرض حالياً. يمكنك رفع ملفات أعلاه أو الضغط على "إضافة مسار صورة".</div>';
      return;
    }

    existingImages.forEach((img, index) => {
      const div = document.createElement('div');
      div.style.cssText = 'border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px; background: #f8fafc; display: flex; gap: 14px; align-items: center; flex-wrap: wrap;';
      const pathVal = img.ImagePath || img.imagePath || '';
      div.innerHTML = `
        <div style="width: 90px; height: 60px; border-radius: 6px; overflow: hidden; background: #0f172a; flex-shrink: 0; border: 1px solid #cbd5e1; display: flex; align-items: center; justify-content: center;">
          ${pathVal ? `<img src="${pathVal}" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.src='/uploads/logos/saylogo.png'">` : '<i class="fa-solid fa-image" style="color: #64748b;"></i>'}
        </div>
        <div style="flex: 2; min-width: 180px;">
          <label style="font-size: 11px; font-weight: 700; display: block; margin-bottom: 2px;">مسار أو رابط الصورة *</label>
          <input type="text" class="form-control" value="${pathVal}" onchange="updateImage(${index}, 'imagePath', this.value)" placeholder="/uploads/systems/screen.png" style="direction: ltr; font-size: 12px; height: 34px;">
        </div>
        <div style="flex: 1.5; min-width: 150px;">
          <label style="font-size: 11px; font-weight: 700; display: block; margin-bottom: 2px;">الوصف (عربي)</label>
          <input type="text" class="form-control" value="${img.CaptionAr || img.captionAr || ''}" onchange="updateImage(${index}, 'captionAr', this.value)" placeholder="شاشة لوحة المتابعة" style="font-size: 12px; height: 34px;">
        </div>
        <div style="flex: 1.5; min-width: 150px;">
          <label style="font-size: 11px; font-weight: 700; display: block; margin-bottom: 2px;">الوصف (إنجليزي)</label>
          <input type="text" class="form-control" value="${img.CaptionEn || img.captionEn || ''}" onchange="updateImage(${index}, 'captionEn', this.value)" placeholder="Dashboard View" style="direction: ltr; font-size: 12px; height: 34px;">
        </div>
        <div style="width: 65px;">
          <label style="font-size: 11px; font-weight: 700; display: block; margin-bottom: 2px;">الترتيب</label>
          <input type="number" class="form-control" value="${img.SortOrder || img.sortOrder || (index + 1)}" onchange="updateImage(${index}, 'sortOrder', this.value)" style="font-size: 12px; height: 34px;">
        </div>
        <div>
          <button type="button" class="btn btn-outline btn-sm" style="color: #dc2626; border-color: #fca5a5; margin-top: 16px; height: 34px;" onclick="removeImage(${index})" title="حذف الصورة">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      `;
      container.appendChild(div);
    });
  }

  function addImageRow() {
    existingImages.push({
      imagePath: '',
      captionAr: '',
      captionEn: '',
      sortOrder: existingImages.length + 1
    });
    renderImages();
  }

  function removeImage(index) {
    existingImages.splice(index, 1);
    renderImages();
  }

  function updateImage(index, key, val) {
    existingImages[index][key] = val;
    if (key === 'imagePath') {
      existingImages[index]['ImagePath'] = val;
    }
  }

  // تسطيح البيانات عند إرسال النموذج
  document.getElementById('systemForm').addEventListener('submit', function() {
    document.getElementById('packagesJson').value = JSON.stringify(existingPackages);
    document.getElementById('faqsJson').value = JSON.stringify(existingFaqs);
    document.getElementById('imagesJson').value = JSON.stringify(existingImages);
  });

  // التهيئة عند التحميل
  renderPackages();
  renderFaqs();
  renderImages();
</script>

<%- include('../partials/admin_footer') %>
