<%- include('../partials/admin_header') %>

<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; flex-wrap: wrap; gap: 15px;">
  <div>
    <h1 style="font-size: 24px; font-weight: 800; color: #0f172a; margin-bottom: 4px;">مكتبة الوسائط والملفات</h1>
    <p style="color: #64748b; font-size: 14px;">استعراض ورفع وإدارة كافة الشعارات وصور المنظومات والصفحات</p>
  </div>

  <!-- نموذج رفع ملف فوري -->
  <form action="/admin/media/upload" method="POST" enctype="multipart/form-data" style="display: flex; gap: 10px; align-items: center;">
    <select name="uploadCategory" class="form-control" style="width: auto;">
      <option value="media">مجلد الوسائط العام (media)</option>
      <option value="logos">مجلد الشعارات (logos)</option>
      <option value="systems">مجلد واجهات المنظومات (systems)</option>
      <option value="pages">مجلد الصفحات (pages)</option>
    </select>
    <input type="file" name="mediaFile" required accept="image/*" class="form-control" style="width: auto;">
    <button type="submit" class="btn btn-primary">
      <i class="fa-solid fa-cloud-arrow-up"></i> رفع ملف
    </button>
  </form>
</div>

<!-- تصفية المجلدات -->
<div style="display: flex; gap: 10px; margin-bottom: 24px;">
  <a href="/admin/media" class="btn <%= !category ? 'btn-primary' : 'btn-outline' %> btn-sm">
    <i class="fa-solid fa-folder"></i> جميع المجلدات
  </a>
  <a href="/admin/media?category=logos" class="btn <%= category === 'logos' ? 'btn-primary' : 'btn-outline' %> btn-sm">
    <i class="fa-solid fa-shield"></i> مجلد الشعارات (logos)
  </a>
  <a href="/admin/media?category=systems" class="btn <%= category === 'systems' ? 'btn-primary' : 'btn-outline' %> btn-sm">
    <i class="fa-solid fa-shapes"></i> واجهات المنظومات (systems)
  </a>
  <a href="/admin/media?category=pages" class="btn <%= category === 'pages' ? 'btn-primary' : 'btn-outline' %> btn-sm">
    <i class="fa-solid fa-file-image"></i> صور الصفحات (pages)
  </a>
  <a href="/admin/media?category=media" class="btn <%= category === 'media' ? 'btn-primary' : 'btn-outline' %> btn-sm">
    <i class="fa-solid fa-photo-film"></i> وسائط عامة (media)
  </a>
</div>

<!-- شبكة الوسائط المرفوعة -->
<div class="table-container" style="padding: 24px;">
  <% if (files && files.length > 0) { %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px;">
      <% files.forEach(f => { %>
        <div style="border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; background: #ffffff; display: flex; flex-direction: column; justify-content: space-between; transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform='translateY(0)'">
          <div style="height: 140px; background: #f8fafc; display: flex; align-items: center; justify-content: center; overflow: hidden; border-bottom: 1px solid #f1f5f9; padding: 10px;">
            <img src="<%= f.path %>" alt="<%= f.filename %>" style="max-height: 100%; max-width: 100%; object-fit: contain;">
          </div>
          <div style="padding: 12px;">
            <div style="font-weight: 700; font-size: 13px; color: #0f172a; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= f.filename %>">
              <%= f.filename %>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 11px; color: #64748b; margin-top: 4px;">
              <span><%= f.category %></span>
              <span><%= f.sizeFormatted %></span>
            </div>
            <div style="display: flex; gap: 6px; margin-top: 10px; justify-content: space-between; border-top: 1px solid #f1f5f9; padding-top: 8px;">
              <!-- نسخ الرابط -->
              <button type="button" class="btn btn-outline btn-sm" style="font-size: 11px; padding: 4px 8px; flex: 1;" onclick="navigator.clipboard.writeText('<%= f.path %>'); alert('تم نسخ رابط الصورة بنجاح: <%= f.path %>')">
                <i class="fa-solid fa-copy"></i> نسخ الرابط
              </button>
              
              <!-- حذف -->
              <form action="/admin/media/delete" method="POST" style="display: inline;" onsubmit="return confirmDeleteWithMasterPassword(this, 'الملف <%= f.filename %>')">
                <input type="hidden" name="filePath" value="<%= f.path %>">
                <button type="submit" class="btn btn-outline btn-sm" style="color: #dc2626; border-color: #fca5a5; padding: 4px 8px;" title="حذف">
                  <i class="fa-solid fa-trash"></i>
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div style="text-align: center; padding: 50px 20px; color: #64748b;">
      <i class="fa-solid fa-images" style="font-size: 40px; margin-bottom: 12px; color: #cbd5e1;"></i>
      <p style="font-size: 15px;">لا توجد ملفات في هذا المجلد حتى الآن.</p>
    </div>
  <% } %>
</div>

<%- include('../partials/admin_footer') %>
