<aside class="admin-sidebar">
  <div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 8px; padding: 6px 8px 18px; border-bottom: 1px solid #1e293b;">
    <% if (settings.SiteLogo) { %>
      <img src="<%= settings.SiteLogo %>" alt="Saysoft Logo" style="height: 48px; max-width: 160px; object-fit: contain; margin-bottom: 4px;">
    <% } %>
    <div>
      <div style="font-weight: 800; font-size: 17px; color: #fff;">لوحة تحكم سايسوفت</div>
      <div style="font-size: 11px; color: #38bdf8; font-weight: 600; margin-top: 2px;">الإصدار المؤسسي 1.0</div>
    </div>
  </div>

  <ul class="admin-nav">
    <li>
      <a href="/admin" class="<%= currentPath === '/admin' ? 'active' : '' %>">
        <i class="fa-solid fa-gauge-high"></i> الرئيسية والإحصائيات
      </a>
    </li>
    <li>
      <a href="/admin/systems" class="<%= currentPath === '/admin/systems' ? 'active' : '' %>">
        <i class="fa-solid fa-shapes"></i> إدارة المنظومات
      </a>
    </li>
    <li>
      <a href="/admin/systems/credentials" class="<%= currentPath === '/admin/systems/credentials' ? 'active' : '' %>">
        <i class="fa-solid fa-key" style="color: #fbbf24;"></i> حسابات مالكي المنظومات
        <span style="font-size: 10px; background: rgba(245, 158, 11, 0.2); color: #fbbf24; padding: 2px 6px; border-radius: 4px; margin-right: 6px; font-weight: 700;">سري</span>
      </a>
    </li>
    <li>
      <a href="/admin/orders" class="<%= currentPath.startsWith('/admin/orders') ? 'active' : '' %>">
        <i class="fa-solid fa-cart-shopping"></i> إدارة الطلبات
      </a>
    </li>
    <li>
      <a href="/admin/messages" class="<%= currentPath.startsWith('/admin/messages') ? 'active' : '' %>">
        <i class="fa-solid fa-envelope"></i> الرسائل والمشتركين
      </a>
    </li>
    <li>
      <a href="/admin/pages" class="<%= currentPath.startsWith('/admin/pages') ? 'active' : '' %>">
        <i class="fa-solid fa-file-lines"></i> الصفحات المخصصة
      </a>
    </li>
    <li>
      <a href="/admin/marketing" class="<%= currentPath.startsWith('/admin/marketing') ? 'active' : '' %>">
        <i class="fa-solid fa-bullhorn"></i> الأسئلة والآراء
      </a>
    </li>
    <li>
      <a href="/admin/media" class="<%= currentPath.startsWith('/admin/media') ? 'active' : '' %>">
        <i class="fa-solid fa-images"></i> مكتبة الوسائط
      </a>
    </li>
    <li>
      <a href="/admin/settings" class="<%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>">
        <i class="fa-solid fa-gear"></i> إعدادات المنصة
      </a>
    </li>
    <li>
      <a href="/admin/users" class="<%= currentPath.startsWith('/admin/users') ? 'active' : '' %>">
        <i class="fa-solid fa-users-gear"></i> إدارة المسؤولين
      </a>
    </li>
    <li style="margin-top: 15px; border-top: 1px solid #1e293b; padding-top: 10px;">
      <a href="/" target="_blank">
        <i class="fa-solid fa-arrow-up-right-from-square"></i> معاينة الموقع
      </a>
    </li>
  </ul>

  <div style="margin-top: auto; padding-top: 20px; border-top: 1px solid #1e293b; display: flex; align-items: center; justify-content: space-between;">
    <div>
      <div style="font-size: 13px; font-weight: 700; color: #f8fafc;"><%= currentUser ? currentUser.FullName || currentUser.Username : 'المدير' %></div>
      <div style="font-size: 11px; color: #94a3b8;"><%= currentUser ? (currentUser.Role === 'ADMIN' ? 'مدير عام' : 'محرر محتوى') : 'ADMIN' %></div>
    </div>
    <a href="/admin/logout" class="btn btn-outline btn-sm" style="color: #ef4444; border-color: #ef4444;" title="تسجيل الخروج">
      <i class="fa-solid fa-right-from-bracket"></i>
    </a>
  </div>
</aside>
