<%- include('../partials/admin_header') %>

<div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px;">
  <div>
    <h1 style="font-size: 24px; font-weight: 800; color: #0f172a; margin-bottom: 4px;">إدارة طلبات الشراء والسلة</h1>
    <p style="color: #64748b; font-size: 14px;">متابعة طلبات العملاء، التواصل المباشر عبر واتساب، وطباعة عروض الأسعار الرسمية</p>
  </div>
</div>

<!-- شريط الفلترة والبحث -->
<div class="table-container" style="margin-bottom: 24px; padding: 16px 20px;">
  <form action="/admin/orders" method="GET" style="display: flex; gap: 14px; align-items: center; flex-wrap: wrap;">
    <div style="flex: 1; min-width: 250px;">
      <input type="text" name="search" class="form-control" placeholder="ابحث برقم الطلب، اسم العميل، أو رقم الواتساب..." value="<%= search %>">
    </div>

    <div style="min-width: 180px;">
      <select name="status" class="form-control" onchange="this.form.submit()">
        <option value="">جميع الحالات</option>
        <option value="PENDING" <%= status === 'PENDING' ? 'selected' : '' %>>جديد (قيد الانتظار)</option>
        <option value="CONTACTED" <%= status === 'CONTACTED' ? 'selected' : '' %>>تم التواصل</option>
        <option value="ACTIVATED" <%= status === 'ACTIVATED' ? 'selected' : '' %>>تم التفعيل والدفع</option>
        <option value="CANCELLED" <%= status === 'CANCELLED' ? 'selected' : '' %>>ملغي</option>
      </select>
    </div>

    <button type="submit" class="btn btn-outline" style="padding: 10px 18px;">
      <i class="fa-solid fa-magnifying-glass"></i> تصفية
    </button>
  </form>
</div>

<!-- جدول الطلبات -->
<div class="table-container">
  <% if (orders && orders.length > 0) { %>
    <table class="admin-table">
      <thead>
        <tr>
          <th>رقم الطلب</th>
          <th>اسم العميل</th>
          <th>الشركة / النشاط</th>
          <th>رقم الواتساب</th>
          <th>إجمالي المبلغ</th>
          <th>الحالة</th>
          <th>تاريخ الطلب</th>
          <th style="text-align: left;">الإجراءات</th>
        </tr>
      </thead>
      <tbody>
        <% orders.forEach(ord => { %>
          <tr>
            <td style="font-weight: 700; color: #0284c7;">
              <a href="/admin/orders/view/<%= ord.IDOrder %>"><%= ord.OrderNumber %></a>
            </td>
            <td style="font-weight: 600;"><%= ord.ClientName %></td>
            <td style="color: #64748b;"><%= ord.CompanyName || '-' %></td>
            <td style="direction: ltr; text-align: right;">
              <a href="https://wa.me/<%= ord.WhatsappNumber.replace(/\+/g, '') %>?text=<%= encodeURIComponent(`مرحباً أستاذ ${ord.ClientName}، نتواصل معك بخصوص طلبك رقم ${ord.OrderNumber} من منصة سايسوفت.`) %>" 
                 target="_blank" style="color: #16a34a; font-weight: 600;">
                <i class="fa-brands fa-whatsapp"></i> <%= ord.WhatsappNumber %>
              </a>
            </td>
            <td style="font-weight: 800; color: #0f172a;">
              <%= ord.TotalAmount %> <%= ord.Currency %>
            </td>
            <td>
              <% if (ord.Status === 'PENDING') { %>
                <span class="badge badge-warning">جديد</span>
              <% } else if (ord.Status === 'CONTACTED') { %>
                <span class="badge badge-primary">تم التواصل</span>
              <% } else if (ord.Status === 'ACTIVATED') { %>
                <span class="badge badge-success">تم التفعيل</span>
              <% } else { %>
                <span class="badge badge-danger">ملغي</span>
              <% } %>
            </td>
            <td style="color: #64748b; font-size: 13px;">
              <%= ord.CreatedAt.toISOString().split('T')[0] %>
            </td>
            <td>
              <div style="display: flex; gap: 8px; justify-content: flex-end;">
                <!-- عرض التفاصيل -->
                <a href="/admin/orders/view/<%= ord.IDOrder %>" class="btn btn-outline btn-sm" title="تفاصيل الطلب">
                  <i class="fa-solid fa-eye"></i>
                </a>

                <!-- طباعة عرض السعر PDF -->
                <a href="/admin/orders/quotation/<%= ord.IDOrder %>" target="_blank" class="btn btn-outline btn-sm" style="color: #0284c7; border-color: #0284c7;" title="طباعة عرض سعر PDF">
                  <i class="fa-solid fa-file-pdf"></i> عرض سعر
                </a>

                <!-- حذف الطلب مع التحقق من كلمة المرور الرئيسية -->
                <form action="/admin/orders/delete/<%= ord.IDOrder %>" method="POST" style="display: inline;" onsubmit="return confirmDeleteWithMasterPassword(this, 'طلب رقم <%= ord.OrderNumber %>')">
                  <button type="submit" class="btn btn-outline btn-sm" style="color: #dc2626; border-color: #fca5a5;" title="حذف">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else { %>
    <div style="text-align: center; padding: 50px 20px; color: #64748b;">
      <i class="fa-solid fa-cart-shopping" style="font-size: 40px; margin-bottom: 12px; color: #cbd5e1;"></i>
      <p style="font-size: 16px;">لا توجد أي طلبات شراء مسجلة حالياً.</p>
    </div>
  <% } %>
</div>

<%- include('../partials/admin_footer') %>
