  <script>
    function setDeviceMode(mode) {
      const wrapper = document.getElementById('pageViewportWrapper');
      const select = document.getElementById('deviceModeSelect');

      // إزالة أنماط المحاكاة السابقة
      wrapper.classList.remove('mode-tablet', 'mode-mobile');

      if (mode === 'tablet') {
        wrapper.classList.add('mode-tablet');
        localStorage.setItem('saysoft_device_mode', 'tablet');
      } else if (mode === 'mobile') {
        wrapper.classList.add('mode-mobile');
        localStorage.setItem('saysoft_device_mode', 'mobile');
      } else {
        localStorage.setItem('saysoft_device_mode', 'desktop');
      }

      const selects = document.querySelectorAll('.device-mode-select, #deviceModeSelect');
      selects.forEach(s => {
        if (s && s.value !== mode) {
          s.value = mode;
        }
      });
    }

    // استعادة وضع العرض المفضل عند التحميل
    document.addEventListener('DOMContentLoaded', () => {
      const savedMode = localStorage.getItem('saysoft_device_mode') || 'desktop';
      if (['tablet', 'mobile', 'desktop'].includes(savedMode)) {
        setDeviceMode(savedMode);
      }
    });
  </script>

